# Copy to .env and restart the dev server to activate real downloads.
#
# 1. Install yt-dlp (https://github.com/yt-dlp/yt-dlp#installation)
# 2. npm run api
# 3. Uncomment the line below.
#
# VITE_DOWNLOAD_API=http://localhost:8787/api/info

# Instagram Reel downloader (mirrors the insta-reels-downloader reference
# flow). Points at the local /api/instagram endpoint (yt-dlp by default).
# VITE_INSTAGRAM_API=http://localhost:8787/api/instagram

# Optional: use the same RapidAPI provider as the reference app. When set,
# /api/instagram proxies through it server-side (the key never reaches the
# browser) and falls back to yt-dlp if the provider fails.
# RAPIDAPI_KEY=your-rapidapi-key

# ---- Server production limits (defaults shown; all optional) ----
# Reject server-side downloads longer than this (reels-focused service).
# MAX_VIDEO_DURATION_SECONDS=180
# VPS safety cap for a single server-side download (browser-side
# ffmpeg.wasm conversion is NOT affected by this).
# MAX_DOWNLOAD_SIZE_MB=300
# Heavy /api/file jobs at once; extras queue (FIFO), then HTTP 429.
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_QUEUE_SIZE=20
# Kill a download job after this long.
# DOWNLOAD_TIMEOUT_SECONDS=180
# Per-IP sliding-window rate limits for expensive endpoints.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_INFO_REQUESTS=30
# RATE_LIMIT_DOWNLOAD_REQUESTS=5
# Refuse new jobs when tmpdir free space drops below this (HTTP 507).
# MIN_FREE_DISK_MB=2048
